        "partitions": [
          {
            "name": "basf_kpis",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Portable snapshot of the repository CSV; not the workbook cleaning query.",
                "    // Rebuild this project after updating the processed CSV.",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=4, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    MissingAsNull = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, {\"value\"}),",
                "    Typed = Table.TransformColumnTypes(MissingAsNull, {{\"year\", Int64.Type}, {\"kpi\", type text}, {\"value\", type number}, {\"unit\", type text}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Report Year",
        "description": "Disconnected year selector; does not shorten history charts.",
        "columns": [
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "formatString": "0",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Report Year",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.FromList({2016..2025}, Splitter.SplitByNothing(), {\"year\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"year\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
