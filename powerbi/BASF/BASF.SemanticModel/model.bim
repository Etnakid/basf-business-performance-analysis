{
  "name": "BASF",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "sourceQueryCulture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"basf_kpis\",\"Report Year\"]"
      },
      {
        "name": "ProcessedCsvSHA256",
        "value": "393023daf578f8c38c509c5873b8ed177566a02711e502cb4cbdd6c725d08822"
      }
    ],
    "tables": [
      {
        "name": "basf_kpis",
        "columns": [
          {
            "name": "year",
            "dataType": "int64",
            "sourceColumn": "year",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "kpi",
            "dataType": "string",
            "sourceColumn": "kpi",
            "summarizeBy": "none"
          },
          {
            "name": "value",
            "dataType": "double",
            "sourceColumn": "value",
            "summarizeBy": "none"
          },
          {
            "name": "unit",
            "dataType": "string",
            "sourceColumn": "unit",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Selected Year",
            "expression": "SELECTEDVALUE('Report Year'[year], MAXX(ALL('Report Year'), 'Report Year'[year]))",
            "formatString": "0",
            "displayFolder": "Selection"
          },
          {
            "name": "Sales",
            "expression": [
              "CALCULATE(SELECTEDVALUE(basf_kpis[value]), basf_kpis[kpi] = \"Sales\")"
            ],
            "displayFolder": "History",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Sales Selected",
            "expression": [
              "VAR Y = [Selected Year]",
              "RETURN CALCULATE([Sales], REMOVEFILTERS(basf_kpis[year]), basf_kpis[year] = Y)"
            ],
            "displayFolder": "Cards",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Sales Previous",
            "expression": [
              "VAR Y = [Selected Year] - 1",
              "RETURN CALCULATE([Sales], REMOVEFILTERS(basf_kpis[year]), basf_kpis[year] = Y)"
            ],
            "displayFolder": "Comparison",
            "formatString": "#,0;(#,0);0"
          },
          {
            "name": "Sales Change",
            "expression": [
              "VAR C = [Sales Selected]",
              "VAR P = [Sales Previous]",
              "RETURN IF(ISBLANK(C) || ISBLANK(P), BLANK(), IF(P > 0 && C >= 0, DIVIDE(C - P, P), BLANK()))"
            ],
            "displayFolder": "Comparison",
            "formatString": "0.0%"
          },
          {
            "name": "Sales Change Label",
            "expression": [
              "VAR D = [Sales Change]",
              "VAR C = [Sales Selected]",
              "VAR P = [Sales Previous]",
              "RETURN SWITCH(TRUE(), ISBLANK(C), \"Not reported\", ISBLANK(P), \"No prior-year value\", ISBLANK(D), \"Loss/zero-base: see history\", FORMAT(D, \"+0.0%;-0.0%;0.0%\") & \" vs PY\")"
            ],
            "displayFolder": "Comparison"
          },
          {
            "name": "EBITDA",
            "expression": [
              "CALCULATE(SELECTEDVALUE(basf_kpis[value]), basf_kpis[kpi] = \"EBITDA\")"
