// Generated from tools/build_powerbi_project.py. Run verification in Desktop.

// Sales
CALCULATE(SELECTEDVALUE(basf_kpis[value]), basf_kpis[kpi] = "Sales")

// Sales Selected
VAR Y = [Selected Year]
RETURN CALCULATE([Sales], REMOVEFILTERS(basf_kpis[year]), basf_kpis[year] = Y)

// Sales Previous
VAR Y = [Selected Year] - 1
RETURN CALCULATE([Sales], REMOVEFILTERS(basf_kpis[year]), basf_kpis[year] = Y)

// Sales Change
VAR C = [Sales Selected]
VAR P = [Sales Previous]
RETURN IF(ISBLANK(C) || ISBLANK(P), BLANK(), IF(P > 0 && C >= 0, DIVIDE(C - P, P), BLANK()))

// Sales Change Label
VAR D = [Sales Change]
VAR C = [Sales Selected]
VAR P = [Sales Previous]
RETURN SWITCH(TRUE(), ISBLANK(C), "Not reported", ISBLANK(P), "No prior-year value", ISBLANK(D), "Not comparable", FORMAT(D, "+0.0%;-0.0%;0.0%") & " vs PY")

